# --- Base de datos -----------------------------------------------------------
# Desarrollo (por defecto):
DATABASE_URL=sqlite:///./suppliers_control.db
# Produccion (SQL Server via ODBC Driver 18):
# DATABASE_URL=mssql+pyodbc://usuario:password@servidor/OrdenesProveedores?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- API de sincronizacion (Power Automate) ----------------------------------
# Clave que Power Automate envia en el header X-API-Key. Cambiala en produccion.
SYNC_API_KEY=cambia-esta-clave

# --- SharePoint (conexion directa, sin Power Automate) -----------------------
# La liga de tu sitio, copiada del navegador.
SP_SITE_URL=https://TUTENANT.sharepoint.com/sites/Proveedores

# "delegado": inicias sesion una vez con tu cuenta. No necesita administrador si
#             el tenant ya tiene consentida la app publica de Microsoft.
# "aplicacion": registro de aplicacion con secreto. Necesita consentimiento de
#               un administrador, una sola vez.
SP_AUTH_MODE=delegado

# Opcional en modo delegado; si tu tenant no permite la app publica, registra una
# aplicacion propia y pon aqui su id. Averigua cual te toca con:
#   python scripts/diagnostico_sharepoint.py
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=

# --- Reglas de negocio -------------------------------------------------------
# Dias sin respuesta del proveedor antes de marcar la orden como "sin respuesta"
NO_RESPONSE_DAYS=3
# Dias de anticipacion para la alerta "por vencer"
DUE_SOON_DAYS=7
# Zona horaria usada en el tablero (solo informativa)
TIMEZONE=America/Tijuana
