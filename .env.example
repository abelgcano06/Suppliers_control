# --- Base de datos -----------------------------------------------------------
# Desarrollo (por defecto):
DATABASE_URL=sqlite:///./suppliers_control.db
# Produccion (SQL Server via ODBC Driver 18):
# DATABASE_URL=mssql+pyodbc://usuario:password@servidor/OrdenesProveedores?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# --- API de sincronizacion (Power Automate) ----------------------------------
# Clave que Power Automate envia en el header X-API-Key. Cambiala en produccion.
SYNC_API_KEY=cambia-esta-clave

# --- Reglas de negocio -------------------------------------------------------
# Dias sin respuesta del proveedor antes de marcar la orden como "sin respuesta"
NO_RESPONSE_DAYS=3
# Dias de anticipacion para la alerta "por vencer"
DUE_SOON_DAYS=7
# Zona horaria usada en el tablero (solo informativa)
TIMEZONE=America/Tijuana
